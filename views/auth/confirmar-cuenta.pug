extends ../layout/index

block contenido
    div(class="py-10 flex justify-center items-center flex-col")
        div( class=" w-1/2  h-10")
            img(class="w-full h-full" src="/img/logo-letras-negro.svg")
        h2.text-center.text-2xl.font-extrabold.my-5.font-serif=pagina

        div(class="bg-white shadow py-8 px-4 rounded-lg")
            p(class= error ? "bg-red-500" : "bg-green-500").py-2.px-5.rounded-lg.w-full=mensaje

            if !error 
                a(href="/auth/login" class="text-center font-bold text-sm text-slate-600 uppercase mt-10 block") Ya Puedes Iniciar Sesion