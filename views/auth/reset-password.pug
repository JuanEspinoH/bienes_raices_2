extends ../layout/index

block contenido
    div(class="py-3 flex items-center justify-center flex-col")
        div( class=" w-1/2  h-10")
            img(class="w-full h-full" src="/img/logo-letras-negro.svg")
        h2.my-3.text-center.text-2xl.font-extrabold.font-serif=pagina

        if errores
            div(class="max-w-md mx-auto my-10 bg-red-600")
                each error in errores
                    p(class=" text-white uppercase text-xs text-center placeholder p-2 mn-1 font-bold")=error.msg

        div(class="shadow-[2px_3px_20px_0px_#008000]").mt-8.mx-auto.max-w-md.w-full
            div.bg-white.py-8.px-4.shadow
                form(class="space-y-5" method="POST" action=`/auth/resetear-password/${token}` novalidate)
                    input(type="hidden" name="_csrf" value=csrfToken)
                    div
                        label.block.text-sm.uppercase.mb-2.font-bold.text-start.text-emerald-900(for="password") Password
                        input#password.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Tu Contraseña" type="password" name="password"
                        value=usuario ? usuario.password :""
                        )
                    div
                        label.block.text-sm.uppercase.mb-2.font-bold.text-start.text-emerald-900(for="repetir_password") Repetir Password
                        input#repetir_password.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Repite Contraseña" type="password" name="repetir_password"
                                                value=usuario ? usuario.repetir_password :""
                        )

                    input(type="submit" value="Resetear Password" class="w-full boton-primario  text-white font-bold py-3 cursor-pointer") 