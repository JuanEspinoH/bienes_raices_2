extends ./layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block contenido
    div(id="mainContainer" class="text-center text-4xl font-extrabold") 

        div(class="h-[90vh] md:h-[100vh] flex items-center justify-center flex-col gap-10")
            h1(class="text-4xl sm:text-5xl md:text-6xl font-serif text-emerald-900 font-extrabold" ) La Casa De Tus Sueños A Un Solo Click De Distancia.
            p(class="text-xl font-normal" ) Busca , Publica , Encuentra y Comparte Varios Tipos De Vivendia e Inmuebles.
        
        div(class="w-full bg-black h-[100vh] sm:h-[90vh] md:h-[100vh] relative  flex items-center justify-center flex-row")
            video(class=" absolute top-0 left-0 right-0 bottom-0 z-0  w-full h-full object-cover transition-all duration-700 opacity-100 ease-in-out" src="https://res.cloudinary.com/donxlmpgp/video/upload/v1759278938/1_p1eifm.mp4"  preload="auto" autoplay muted  id="videoContainer" )
            
            div(class="w-[80%] z-10 h-[25%] gap-2 sm:gap-3 flex-col flex justify-between items-center p-5 bg-gray-800 rounded-md bg-clip-padding backdrop-filter backdrop-blur-sm bg-opacity-10 border border-gray-100 relative" id="videoItemsCont")
                div(class="absolute  flex justify-center items-center flex-col" id="videoItem1" )
                    <svg class="sm:size-14  size-12 md:size-16 aspect-square fill-emerald-800 rounded-full border-yellow-600 border-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M224 96C206.3 96 192 110.3 192 128C192 145.7 206.3 160 224 160L288 160L288 480L224 480C206.3 480 192 494.3 192 512C192 529.7 206.3 544 224 544L416 544C433.7 544 448 529.7 448 512C448 494.3 433.7 480 416 480L352 480L352 128C352 110.3 337.7 96 320 96L224 96z"/></svg>
                    p(class="sm:text-lg text-base md:text-xl text-white text-shadow-lg") Publica tu inmueble en minutos y sin complicaciones.
   
                div(class="flex absolute justify-center items-center flex-col opacity-0" id="videoItem2")
                    <svg class="sm:size-14  size-12 md:size-16 aspect-square fill-emerald-800 rounded-full border-yellow-600 border-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M176 128C176 110.3 190.3 96 208 96L379 96C439.2 96 488 144.8 488 205C488 248.8 461.8 288.3 421.6 305.4L282.5 364.4C247 379.4 224 414.2 224 452.7L224 480L448 480C465.7 480 480 494.3 480 512C480 529.7 465.7 544 448 544L192 544C174.3 544 160 529.7 160 512L160 452.7C160 388.5 198.4 330.5 257.5 305.4L396.6 246.4C413.2 239.3 424 223 424 205C424 180.1 403.8 160 379 160L208 160C190.3 160 176 145.7 176 128z"/></svg>
                    p(class="sm:text-lg text-base md:text-xl text-white text-shadow-lg") Comparte propiedades favoritas con amigos o familiares rápidamente.

                div(class="flex absolute justify-center items-center flex-col opacity-0" id="videoItem3")
                    <svg class="sm:size-14  size-12 md:size-16 aspect-square fill-emerald-800 rounded-full border-yellow-600 border-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M240 352C222.3 352 208 337.7 208 320C208 302.3 222.3 288 240 288L352 288C387.3 288 416 259.3 416 224C416 188.7 387.3 160 352 160L192 160C174.3 160 160 145.7 160 128C160 110.3 174.3 96 192 96L352 96C422.7 96 480 153.3 480 224C480 262.2 463.2 296.5 436.7 320C463.3 343.5 480 377.8 480 416C480 486.7 422.7 544 352 544L192 544C174.3 544 160 529.7 160 512C160 494.3 174.3 480 192 480L352 480C387.3 480 416 451.3 416 416C416 380.7 387.3 352 352 352L240 352z"/></svg>
                    p(class="sm:text-md text-xl text-white text-shadow-lg") Busca fácilmente la vivienda ideal para tus necesidades.

                div(class="flex absolute justify-center items-center flex-col opacity-0" id="videoItem4")
                    <svg class="sm:size-14  size-12 md:size-16 aspect-square fill-emerald-800 rounded-full border-yellow-600 border-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M192 128C192 110.3 177.7 96 160 96C142.3 96 128 110.3 128 128L128 352C128 387.3 156.7 416 192 416L384 416L384 512C384 529.7 398.3 544 416 544C433.7 544 448 529.7 448 512L448 416L480 416C497.7 416 512 401.7 512 384C512 366.3 497.7 352 480 352L448 352L448 128C448 110.3 433.7 96 416 96C398.3 96 384 110.3 384 128L384 352L192 352L192 128z"/></svg>
                    p(class="sm:text-md text-xl text-white text-shadow-lg") Encuentra opciones de casas y departamentos en tu ciudad.
                

        
        
        h2(class="text-sm uppercase text-gray-800 font-bold mt-8 mb-2") Filtrar Propiedades:
        div(class="flex flex-col md:flex-row  items-center py-10 gap-4 ")
            div(class="w-full flex items-center gap-2 ")
                label(for="categorias" class="text-sm w-24 uppercase text-gray-500 font-bold") Categorias
                select( id="categorias" class="bg-white w-full flex-1 px-3 text-sm py-2 border border-gray-300 rounded-md shadow")  
                    option(value="" class="text-sm text-center") -Selecciona-
                    each categoria in categorias
                        option(value=categoria.id class="text-sm" )=categoria.nombre 

            div(class="w-full flex items-center gap-2 ")
                label(for="precios" class="text-sm w-24 uppercase text-gray-500 font-bold") Precios
                select( id="precios" class="bg-white w-full flex-1 px-3  text-sm py-2 border border-gray-300 rounded-md shadow")  
                    option(value="" class="text-sm text-center") -Selecciona-
                    each precio in precios
                        option(value=precio.id class="text-sm" )=precio.nombre 

        div(class="h-[600px] mt-5  rounded-lg" id="mapa")

        section(class="py-5" id="propertiesContainer")
            h2(class="text-center text-4xl font-extrabold pt-10") Bodegas en Venta
            div( class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-14")
                each propiedad in casas
                    include ./templates/card

        section(class="py-5" id="propertiesContainer")
            h2(class="text-center text-4xl font-extrabold pt-10") Departamentos en Venta
            div( class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-14")
                each propiedad in bodegas
                    include ./templates/card

        section(class="py-5" id="propertiesContainer")
            h2(class="text-center text-4xl font-extrabold pt-10") Casas en Venta
            div( class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-14")
                each propiedad in departamentos
                    include ./templates/card

        section(class="py-5" id="propertiesContainer")
            h2(class="text-center text-4xl font-extrabold pt-10") Terrenos en Venta
            div( class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-14")
                each propiedad in terrenos
                    include ./templates/card

        section(class="py-5" id="propertiesContainer" )
            h2(class="text-center text-4xl font-extrabold pt-10") Cabañas en Venta
            div(class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-14")
                each propiedad in cabañas
                    include ./templates/card
        
    

                            


block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js")
    script(src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js")
    script(src="/js/mapaInicio.js")
    script(src="/js/scrollAnimation.js")