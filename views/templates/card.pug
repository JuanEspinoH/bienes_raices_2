div(class=" h-[33rem] pt-3 rounded-lg shadow-[7px_-6px_8px_1px_rgba(0,_0,_0,_0.3)] ")
    div(class=" h-[50%] w-full")
        img(class="object-cover h-full w-full " src=`${propiedad.imagen}` alt=`imagen propiedad ${propiedad.titulo}`)
    div(class="p-3 space-y-2 flex flex-col text-start h-[40%] ")
        
        if propiedad.categoria.nombre
            p(class="text-sm text-emerald-950")=propiedad.categoria.nombre 
        
        h3(class=`text-xl sm:text-2xl lg:text-2xl font-bold underline decoration-dashed decoration-yellow-700 ${propiedad.titulo.length > 20 ? "md:text-base" : "md:text-lg"}`  )=propiedad.titulo
        p(class="text-sm text-gray-600") Habitaciones: 
            span(class="text-black font-bold")=propiedad.habitaciones

        p(class="text-sm text-gray-600") WC: 
            span(class="text-black font-bold")=propiedad.wc

        p(class="text-sm text-gray-600") Precio: 
            span(class="text-black font-bold text-sm")=propiedad.precio.nombre
                            
    a(href=`/propiedad/${propiedad.id}` class=" boton-primario  h-[10%] w-full flex justify-center items-center  font-bold text-white p-1 uppercase rounded-bl rounded-br text-sm  ") 
        p(class="font-serif text-lg") Ver propiedad