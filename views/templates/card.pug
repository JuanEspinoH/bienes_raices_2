div(class="bg-whiteshadow rounded-lg  ")
    img(class="object-cover p-2 h-72 w-full" src=`${propiedad.imagen}` alt=`imagen propiedad ${propiedad.titulo}`)
    div(class="p-5 space-y-2 text-start h-1/3 ")
        h3(class="text-2xl font-bold"  )= propiedad.titulo
        p(class="text-sm text-gray-600") Habitaciones: 
            span(class="text-gray-800 font-bold")=propiedad.habitaciones

        p(class="text-sm text-gray-600") WC: 
            span(class="text-gray-800 font-bold")=propiedad.wc

        p(class="text-sm text-gray-600") Precio: 
            span(class="text-gray-800 font-bold text-sm")=propiedad.precio.nombre
                            
    a(href=`/propiedad/${propiedad.id}` class="bg-indigo-600 mt-1 md:mt-7 lg:mt-5 w-full text-center block font-bold text-white p-2 uppercase rounded text-sm") Ver propiedad